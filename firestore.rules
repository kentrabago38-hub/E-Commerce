rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products catalog - publicly readable, writable by admin/authenticated operations
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Categories showcase - publicly readable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Wine reviews & sommelier notes - publicly readable
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Orders & cold-chain consignments
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Customer & Sommelier profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
