rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products catalog - read and write access for store operations and seeding
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories showcase
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Wine reviews & sommelier notes
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Orders & cold-chain consignments
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customer & Sommelier profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
